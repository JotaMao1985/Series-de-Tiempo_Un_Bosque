> aicc <- function(f, n) {
+     k <- length(f$coef) + 1
+     f$aic + 2 * k * (k + 1)/(n - k - 1)
+ }
> n <- length(BJsales)
> round(sapply(0:3, function(d) var(if (d == 0) BJsales else diff(BJsales, 
