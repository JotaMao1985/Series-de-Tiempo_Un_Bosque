> for (q in 0:2) for (p in 0:2) {
+     f <- arima(BJsales, order = c(p, 1, q), method = "ML")
+     cat(sprintf("ARIMA(%d,1,%d)  AICc=%8.3f  BIC=%8.3f  LB(20) p=%.4f\n", 
+         p, q, aicc(f, n - 1), BIC(f), Box.test(residuals(f), 
+             lag = 20, type = "Ljung-Box", fitdf = p + q)$p.value))
+ }
