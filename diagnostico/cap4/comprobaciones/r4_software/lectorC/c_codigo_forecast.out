== myarima: umbral de raíces
 [1] "            fit$aic <- fit$bic <- fit$aicc <- fit$ic <- Inf"
 [2] "        minroot <- 2"                                       
 [3] "                  minroot <- min(minroot, abs(proots))"     
 [4] "                  fit$ic <- Inf"                            
 [5] "        if (order[3] + seasonal[3] > 0 && fit$ic < Inf) {"  
 [6] "                  minroot <- min(minroot, abs(proots))"     
 [7] "                  fit$ic <- Inf"                            
 [8] "        if (minroot < 1 + 0.01 || checkarima(fit)) {"       
 [9] "            fit$ic <- Inf"                                  
[10] "            cat(\" :\", Inf)"                               
[11] "        return(list(ic = Inf))"                             

