[forecast::BoxCox] variante con signo:
{
    if (lambda == "auto") {
        lambda <- BoxCox.lambda(x, lower = -0.9)
    }
    if (lambda < 0) {
        x[x < 0] <- NA
    }
    if (lambda == 0) {
        out <- log(x)
    }
    else {
        out <- (sign(x) * abs(x)^lambda - 1)/lambda
    }
    if (!is.null(colnames(x))) {
        colnames(out) <- colnames(x)
    }
    attr(out, "lambda") <- lambda
    out
}

[fabletools::box_cox]:
{
    lambda <- vec_recycle(lambda, vec_size(x))
    x[lambda < 0 & x < 0] <- NA
    lambda_0 <- lambda == 0
    x[lambda_0] <- log(x[lambda_0])
    x[!lambda_0] <- (sign(x[!lambda_0]) * abs(x[!lambda_0])^lambda[!lambda_0] - 
        1)/lambda[!lambda_0]
    x
}

