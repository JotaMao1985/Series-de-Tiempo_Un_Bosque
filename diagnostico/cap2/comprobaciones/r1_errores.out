== Truncamiento: qué pasa ndiffs a ur.kpss y qué usa ur.kpss por defecto ==
    kpss_wrap <- function(..., use.lag = trunc(3 * sqrt(length(x))/13)) {
        ur.kpss(..., use.lag = use.lag)
            lmax <- trunc(4 * (n/100)^0.25)
        lmax <- trunc(4 * (n/100)^0.25)
        lmax <- trunc(12 * (n/100)^0.25)
formals(ur.kpss)$lags: c("short", "long", "nil") 

