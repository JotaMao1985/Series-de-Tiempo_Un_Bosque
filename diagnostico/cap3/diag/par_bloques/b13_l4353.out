0 0 0 0 0 

> round(ARMAacf(ar = 0.5, ma = -0.45, lag.max = 5)[-1], 
+     4)
     1      2      3      4      5 
0.0515 0.0257 0.0129 0.0064 0.0032 

> set.seed(11)

> y <- arima.sim(n = 200, list(ar = 0.5, ma = -0.45))

> ajuste <- arima(y, order = c(1, 0, 1))

> round(cbind(coef = coef(ajuste), ee = sqrt(diag(ajuste$var.coef))), 
+     4)
             coef     ee
ar1        0.8300 0.2307
ma1       -0.7953 0.2477
intercept  0.0137 0.0806

> aicc <- function(f, n) {
+     k <- length(f$coef) + 1
+     f$aic + 2 * k * (k + 1)/(n - k - 1)
+ }

> c(arma11 = aicc(ajuste, 200), ar1 = aicc(arima(y, 
+     order = c(1, 0, 0)), 200), ruido = aicc(arima(y, order = c(0, 
+     0, 0)), 200))
