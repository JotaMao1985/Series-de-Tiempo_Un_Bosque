   +        /* Lo que queda corto crece. Tres viñetas a 23 px en una lámina de 720
   +           dejan media pantalla vacía y un texto que no se lee desde el fondo:
   +           si el cuerpo ocupa menos de `LLENO` (el 80 %) de su alto, se agranda de 4 en 4 %
   +           hasta ocuparlo, hasta `K_MAX` o hasta que algo desborde (a lo ancho
   +           también: un bloque de código no crece más allá de su columna). No
   +           crecen las diapositivas con `escala=` o `.denso` (lo pidió la fuente),
   +           ni las que no tienen cabecera corriente (idea, gancho, dato), ni
   +           `.plena`, que ya reparte su alto. */
   +        const K_MAX = 1.24;
   +        const LLENO = 0.8;
   +        const puedeCrecer = (d) => !d.dataset.k && !d.classList.contains('denso') && !d.classList.contains('plena')
   +            && !!d.querySelector(':scope > .marco > .cabecera') && !!d.querySelector(':scope > .marco > .cuerpo');
   +        const ocupacion = (d) => {
   +            const c = d.querySelector(':scope > .marco > .cuerpo');
   +            const hijos = Array.from(c.children).filter((el) => el.offsetHeight > 0);
   +            if (!hijos.length) return 1;
   +            const caja = c.getBoundingClientRect();
   +            const arriba = Math.min(...hijos.map((el) => el.getBoundingClientRect().top));
   +            const abajo = Math.max(...hijos.map((el) => el.getBoundingClientRect().bottom));
   +            return caja.height > 0 ? (abajo - arriba) / caja.height : 1;
   +        };
   +
   @@ -168,0 +191,9 @@
