M6 · Python · seasonal_decompose (bloque del capitulo, sin cambios)
----------------------------------------------------------------------
# Descomposicion clasica multiplicativa
from statsmodels.tsa.seasonal import seasonal_decompose

dc = seasonal_decompose(pasajeros, model="multiplicative", period=12)
dc.plot()

# La version aditiva, la que este modulo descarta al final
da = seasonal_decompose(pasajeros, model="additive", period=12)
print("tendencia jul-1955:", dc.trend["1955-07-01"], " NaN:", int(dc.trend.isna().sum()), " indice julio:", round(dc.seasonal["1955-07-01"], 4))
