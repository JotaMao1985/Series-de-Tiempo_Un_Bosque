M6 · R · filtro del paso 2: stats::filter(y, c(0.5, rep(1, m - 1), 0.5) / m)
----------------------------------------------------------------------
y <- AirPassengers; m <- 12
f <- stats::filter(y, c(0.5, rep(1, m - 1), 0.5) / m)
cat("jul-1955:", f[79], " NA:", sum(is.na(f)), " igual a decompose()$trend:", isTRUE(all.equal(as.numeric(f), as.numeric(decompose(y)$trend))), "\n")
