M5 · R · media movil 2x12 en dos pasos
----------------------------------------------------------------------
# Media movil centrada 2x12 en dos pasos: una 12-MA y, sobre ella, una 2-MA
suppressPackageStartupMessages({library(tsibble); library(dplyr); library(ggplot2); library(fabletools); library(feasts)})
pasajeros <- as_tsibble(AirPassengers) |>
  mutate(
    `12-MA`   = slider::slide_dbl(value, mean,
                  .before = 5, .after = 6, .complete = TRUE),
    tendencia = slider::slide_dbl(`12-MA`, mean,
                  .before = 1, .after = 0, .complete = TRUE)
  )
pasajeros |>
  autoplot(value) +
  geom_line(aes(y = tendencia), colour = "#FF6600", linewidth = 1)

# Control: la tendencia de julio de 1955
pasajeros |> filter(index == yearmonth("1955 Jul")) |> pull(tendencia)
#> [1] 285.75
----------------------------------------------------------------------
SALIDA:
[1] 285.75
NA en tendencia: 12
