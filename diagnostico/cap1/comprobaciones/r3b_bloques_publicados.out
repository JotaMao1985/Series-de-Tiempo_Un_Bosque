M8 · Python · desestacionalizada y fuerzas
----------------------------------------------------------------------
# La STL de partida del Modulo 7, sobre el logaritmo
import numpy as np
from statsmodels.tsa.seasonal import STL

n = len(pasajeros)
res = STL(np.log(pasajeros), period=12, seasonal=10 * n + 1, seasonal_deg=0,
          trend=19, robust=False).fit(inner_iter=2, outer_iter=0)

# Serie desestacionalizada, de vuelta en miles de pasajeros: y / exp(S)
ajustada = pasajeros / np.exp(res.seasonal)
print(round(ajustada["1955-07-01"], 1))          # 293.2

# Fuerza de la tendencia y de la estacionalidad
FT = max(0, 1 - res.resid.var() / (res.trend + res.resid).var())
FS = max(0, 1 - res.resid.var() / (res.seasonal + res.resid).var())
print(round(FT, 3), round(FS, 3))                # 0.994 0.937

import matplotlib.pyplot as plt
pasajeros.plot(label="observada", color="grey")
ajustada.plot(label="desestacionalizada")
plt.legend(); plt.show()
