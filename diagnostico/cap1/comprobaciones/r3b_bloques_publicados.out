M8 · R · desestacionalizada y fuerzas
----------------------------------------------------------------------
# La STL de partida del Modulo 7, sobre el logaritmo (R base)
st <- stl(log(AirPassengers), s.window = "periodic")$time.series
Tt <- st[, "trend"]; St <- st[, "seasonal"]; Rt <- st[, "remainder"]

# Serie desestacionalizada, de vuelta en miles de pasajeros: y / exp(S)
ajustada <- AirPassengers / exp(St)
round(window(ajustada, start = c(1955, 7), end = c(1955, 7)), 1)   # 293.2
plot(AirPassengers, col = "grey50"); lines(ajustada, lwd = 2)

# Fuerza de la tendencia y de la estacionalidad
FT <- max(0, 1 - var(Rt) / var(Tt + Rt))
FS <- max(0, 1 - var(Rt) / var(St + Rt))
round(c(FT = FT, FS = FS), 3)
#>    FT    FS
#> 0.994 0.937

# Con tidyverts: components() trae la columna season_adjust, y feat_stl() da
# las fuerzas con su propia STL (s.window = 11): 0.997 y 0.964
library(fpp3)
pasajeros <- as_tsibble(log(AirPassengers))
pasajeros |>
  model(STL(value ~ trend(window = 19) + season(window = "periodic"))) |>
  components() |>
  mutate(ajustada = exp(season_adjust))
pasajeros |> features(value, feat_stl)
