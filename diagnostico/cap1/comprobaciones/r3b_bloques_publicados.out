M7 · Python · STL, con las dos respuestas encendidas al final
----------------------------------------------------------------------
# STL sobre log(AirPassengers), con ajustes equivalentes a los del bloque de R:
# estacionalidad periodica, ventana de tendencia de 19 y sin robustez.
# No es identico: R evalua el ajuste local a saltos e interpola, y statsmodels
# lo hace en cada punto. La diferencia es menor de 0.001 en el componente
# estacional y de 0.003 en la tendencia.
import numpy as np
from statsmodels.tsa.seasonal import STL

n = len(pasajeros)
stl = STL(np.log(pasajeros), period=12,
          seasonal=10 * n + 1, seasonal_deg=0,   # lo que R llama s.window = "periodic"
          trend=19, robust=False)
res = stl.fit(inner_iter=2, outer_iter=0)        # las pasadas que da stl() en R
res.plot()

print(round(res.seasonal["1955-07-01"], 4))      # 0.2164, el julio de la figura

# Las dos respuestas apagadas, encendidas: s.window = 11 y robust = TRUE
s11 = STL(np.log(pasajeros), period=12, seasonal=11, seasonal_deg=0,
          trend=21).fit(inner_iter=2, outer_iter=0)
rob = STL(np.log(pasajeros), period=12, seasonal=10 * n + 1, seasonal_deg=0,
          trend=19, robust=True).fit(inner_iter=1, outer_iter=15)
print(np.exp(s11.seasonal[["1949-07-01", "1960-07-01"]]).round(3).values)   # [1.204 1.279]
print((rob.weights < 1e-8).sum())                                           # 4
----------------------------------------------------------------------
